# ---------------------------------------------------------------------------
# Public (baked into the client bundle at build time — never put secrets here)
# ---------------------------------------------------------------------------

# Canonical origin used for metadata, sitemap and canonical URLs.
NEXT_PUBLIC_SITE_URL=https://modelstrike.ai

# Optional. If set, shown on the contact page and footer as a direct email.
# Leave empty to hide it.
NEXT_PUBLIC_CONTACT_EMAIL=

# Cal.com event for booking the consultation call: `user/event` or a full
# https://cal.com/... URL. With form delivery configured, the calendar appears
# after the form is sent; without it, the calendar is shown up front.
# Leave empty for no calendar (and no Cal.com origins in the CSP).
NEXT_PUBLIC_CAL_LINK=modelstrike/30min

# Optional extra CSP origins, space-separated (build-time).
CSP_SCRIPT_SRC=
CSP_CONNECT_SRC=
CSP_FRAME_SRC=

# ---------------------------------------------------------------------------
# Server-only (runtime secrets — read only by the contact Server Action)
# ---------------------------------------------------------------------------

# Which delivery provider receives consultation requests: "resend" or "webhook".
# Until one is fully configured the form tells visitors it can't accept
# submissions yet instead of pretending to succeed.
CONTACT_DELIVERY=

# --- Resend (https://resend.com) ---
RESEND_API_KEY=
# Inbox that receives leads, e.g. your own business address.
CONTACT_TO_EMAIL=
# Verified sender on your Resend domain, e.g. "ModelStrike Website <website@modelstrike.ai>".
# When RESEND_API_KEY and CONTACT_FROM_EMAIL are both set, visitors also get a
# short confirmation email (it never echoes what they typed) — with either provider.
CONTACT_FROM_EMAIL=

# --- Generic webhook (Zapier, Make, n8n, a CRM inbound endpoint, …) ---
# Receives a JSON POST: { name, email, company, industry, message, submittedAt, source }.
CONTACT_WEBHOOK_URL=
# Optional. Signs the body: "X-ModelStrike-Signature: sha256=<hex HMAC-SHA256 of the raw body>".
CONTACT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# AI customer intake demo (/demo) — server-only runtime settings
# ---------------------------------------------------------------------------

# OpenAI API key. When set, /demo processes inquiries with a real model
# (server-side only). Leave empty to offer only precomputed examples, which are
# labelled "Example Preview — Not Live AI Processing".
OPENAI_API_KEY=

# Daily spending ceiling in USD, enforced in code. Resets at midnight UTC.
# Also set a project budget in the OpenAI dashboard as a backstop.
DEMO_DAILY_BUDGET_USD=5
# Requests per IP per 10 minutes, requests per hour site-wide, and runs in
# flight at once. A mistyped value counts as 0 and blocks the demo.
DEMO_IP_LIMIT=8
DEMO_HOURLY_LIMIT=200
DEMO_MAX_CONCURRENCY=4
# Where the day's spend is saved so restarts don't reset it. compose.yaml sets
# this to a volume. Without it the budget is kept in memory only.
# DEMO_BUDGET_FILE=/app/data/demo-budget.json

# ---------------------------------------------------------------------------
# Customer onboarding questionnaire (/onboarding) — server-only runtime settings
# See docs/ONBOARDING.md. Until both are set (https URL, secret >= 32 chars),
# /onboarding says onboarding is unavailable and accepts nothing.
# ---------------------------------------------------------------------------

# Sales Swarm base URL (a hostname over https, never a raw EC2 IP).
ONBOARDING_API_URL=
# Shared HMAC secret, same value as in the Sales Swarm. `openssl rand -base64 48`
ONBOARDING_API_SECRET=
# Development only: in-memory mock with fictional data. Ignored in production.
# ONBOARDING_MOCK=true

# ---------------------------------------------------------------------------
# Docker Compose (only used with `--profile proxy`)
# ---------------------------------------------------------------------------

# Domain Caddy obtains a TLS certificate for. www.<domain> redirects to it.
SITE_DOMAIN=modelstrike.ai
